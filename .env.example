# TFrenzy Handwritten Document Intelligence Platform Environment Configuration
# Save a copy as .env for local runtime settings

# Server Configuration
PORT=3000
NODE_ENV=development
# Frontend production backend origin
# Example:
# VITE_API_BASE_URL=https://your-render-service.onrender.com
VITE_API_BASE_URL=
# Required: generate a long, random value for each environment. The server will
# refuse to start without it rather than issuing forgeable tokens.
JWT_SECRET_KEY=replace-with-a-long-random-secret
DEMO_ADMIN_EMAIL=rithika@tfrenzy.ai
DEMO_ADMIN_PASSWORD=replace-with-a-local-demo-password

# PostgreSQL Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tfrenzy_doc_db
POSTGRES_USER=tfrenzy_user
POSTGRES_PASSWORD=your_postgres_password

# Optional Direct Database Connection String
# DATABASE_URL=postgresql://postgres:your_postgres_password@localhost:5432/tfrenzy

# OCR provider: trocr (default local handwritten-text transformer) or tesseract
OCR_PROVIDER=trocr
PYTHON_EXECUTABLE=python
HANDWRITING_OCR_MODEL=microsoft/trocr-base-handwritten
CORS_ORIGIN=https://your-site.netlify.app
DUPLICATE_SIMILARITY_THRESHOLD=0.75
